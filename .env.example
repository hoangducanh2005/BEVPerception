NUSCENES_VERSION=v1.0-mini
MMDETECTION3D_ROOT=/path/to/mmdetection3d
BEVFUSION_CHECKPOINT=/path/to/bevfusion_checkpoint.pth
LIDAR_CHECKPOINT=/path/to/lidar_checkpoint.pth
YOLO2D_CHECKPOINT=/path/to/yolo26m.pt
OUTPUT_ROOT=outputs
